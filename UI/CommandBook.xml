<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Frame name="Forged_Mangosbot_CommandBookFrame" parent="UIParent" hidden="true" movable="true" enableMouse="true" frameStrata="DIALOG" toplevel="true">
        <Size>
            <AbsDimension x="540" y="440"/>
        </Size>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Backdrop bgFile="Interface/DialogFrame/UI-DialogBox-Background" edgeFile="Interface/Tooltips/UI-Tooltip-Border" tile="true" tileSize="16" edgeSize="12">
            <BackgroundInsets>
                <AbsInset left="4" right="4" top="4" bottom="4"/>
            </BackgroundInsets>
        </Backdrop>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentTitle" inherits="GameFontNormalLarge" text="Companion Command Book">
                    <Anchors>
                        <Anchor point="TOP" x="0" y="-16"/>
                    </Anchors>
                </FontString>
                <FontString name="$parentPageText" inherits="GameFontHighlightSmall" text="Page 1/1">
                    <Anchors>
                        <Anchor point="BOTTOM" x="0" y="18"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button name="$parentClose" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-4" y="-4"/>
                </Anchors>
            </Button>
            <Button name="$parentPrevPage" inherits="UIPanelButtonTemplate" text="<">
                <Size>
                    <AbsDimension x="24" y="22"/>
                </Size>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" x="200" y="10"/>
                </Anchors>
            </Button>
            <Button name="$parentNextPage" inherits="UIPanelButtonTemplate" text=">">
                <Size>
                    <AbsDimension x="24" y="22"/>
                </Size>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" x="-200" y="10"/>
                </Anchors>
            </Button>
            <Frame name="$parentTabContainer">
                <Size>
                    <AbsDimension x="510" y="56"/>
                </Size>
                <Anchors>
                    <Anchor point="TOP" x="0" y="-44"/>
                </Anchors>
            </Frame>
            <Frame name="$parentGridContainer">
                <Size>
                    <AbsDimension x="500" y="300"/>
                </Size>
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentTabContainer" relativePoint="BOTTOM" x="0" y="-8"/>
                </Anchors>
                <Backdrop bgFile="Interface/ChatFrame/ChatFrameBackground" tile="true" tileSize="16" edgeSize="2">
                    <BackgroundInsets>
                        <AbsInset left="0" right="0" top="0" bottom="0"/>
                    </BackgroundInsets>
                </Backdrop>
            </Frame>
            <Frame name="$parentCompanionContainer" hidden="true">
                <Size>
                    <AbsDimension x="500" y="300"/>
                </Size>
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentTabContainer" relativePoint="BOTTOM" x="0" y="-8"/>
                </Anchors>
                <Backdrop bgFile="Interface/ChatFrame/ChatFrameBackground" tile="true" tileSize="16" edgeSize="2">
                    <BackgroundInsets>
                        <AbsInset left="0" right="0" top="0" bottom="0"/>
                    </BackgroundInsets>
                </Backdrop>
            </Frame>
        </Frames>
    </Frame>
</Ui>
